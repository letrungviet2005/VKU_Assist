APP_NAME=VKU Assist
APP_ENV=development
LOG_LEVEL=INFO
# JSON array; origins must not contain a trailing slash.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RETRIEVAL_ENABLED=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
MODEL_CACHE=.model-cache
DATA_DIR=data
INDEX_DIR=indexes
CHUNK_SIZE=300
CHUNK_OVERLAP=50
SEARCH_TOP_K=5
CHAT_ENABLED=false
LLM_PROVIDER=bedrock
# Fill with a Region/model or inference profile verified by your team.
BEDROCK_REGION=
BEDROCK_MODEL_ID=
# Optional local profile name, never AWS access keys. Leave empty on EC2.
BEDROCK_AWS_PROFILE=
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_MAX_CONCURRENCY=2
