APP_NAME=VKU Assist
APP_ENV=development
LOG_LEVEL=INFO
# JSON array; origins must not contain a trailing slash.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RETRIEVAL_ENABLED=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
MODEL_CACHE=.model-cache
DATA_DIR=data
INDEX_DIR=indexes
CHUNK_SIZE=300
CHUNK_OVERLAP=50
SEARCH_TOP_K=5
