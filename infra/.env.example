# ==============================================================================
# VKU Assist - Production Deployment Environment Template
# ==============================================================================
# Thông tin ứng dụng
APP_NAME=VKU Assist
APP_ENV=production
LOG_LEVEL=INFO

# Cấu hình CORS (Định dạng JSON Array, không có dấu / ở cuối)
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:5173","http://127.0.0.1:5173"]

# Cấu hình RAG & Mô hình vector nhúng
RETRIEVAL_ENABLED=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
MODEL_CACHE=.model-cache
DATA_DIR=data
INDEX_DIR=indexes
CHUNK_SIZE=300
CHUNK_OVERLAP=50
SEARCH_TOP_K=5

# Cấu hình Chat & LLM Adapter
CHAT_ENABLED=true
LLM_PROVIDER=fake
# Nếu dùng AWS Bedrock trong môi trường sản xuất:
# LLM_PROVIDER=bedrock
# BEDROCK_REGION=ap-southeast-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_AWS_PROFILE=
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_MAX_CONCURRENCY=4

# Tầng Lưu trữ dữ liệu (sqlite / dynamodb)
STORAGE_BACKEND=sqlite
DB_PATH=data/vku_assist.db
# Cấu hình AWS DynamoDB (nếu STORAGE_BACKEND=dynamodb)
DYNAMODB_TABLE_NAME=vku_assist_persistence
DYNAMODB_REGION=ap-southeast-1
DYNAMODB_ENDPOINT_URL=

# Kho lưu trữ tệp tài liệu S3 (nếu tải lên S3)
S3_BUCKET_NAME=
S3_REGION=ap-southeast-1
S3_ENDPOINT_URL=

# Tài khoản Quản trị viên Kho văn bản
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vku2026
JWT_SECRET_KEY=vku-assist-production-jwt-secret-key-replace-in-real-production-environment-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
